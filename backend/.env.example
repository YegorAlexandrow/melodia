# --- MongoDB ---
MONGO_URL=mongodb://localhost:27017
DB_NAME=vinyl

# --- Медиа: базовые URL для сборки публичных ссылок на обложки/аудио ---
# Пусто = key используется как есть (loc=WEB) либо как относительный путь.
MEDIA_S3_BASE_URL=
MEDIA_LOCAL_BASE_URL=

# --- Discogs (нужно на следующем шаге; персональный токен + уникальный User-Agent) ---
DISCOGS_TOKEN=
DISCOGS_USER_AGENT=MelodiaCatalog/0.1 (+self-hosted)

# --- CORS: источники фронтенда (JSON-массив) ---
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
